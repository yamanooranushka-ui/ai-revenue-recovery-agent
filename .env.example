# ---------------------------------------------------------------------------
# .env.example - TEMPLATE ONLY. Placeholders, never real credentials.
#
# This project has NO dotenv dependency: it reads environment variables
# directly from the process. Use this file as a reference and either:
#   - set the variables in your shell, e.g.  set GEMINI_API_KEY=... (CMD)
#                                              $env:GEMINI_API_KEY=... (PowerShell)
#   - or point your IDE's run configuration at a COPY of this file.
#
# Copy to `.env` for your tooling if you like - `.env` is gitignored.
# NEVER put a real key in a file you intend to commit.
# ---------------------------------------------------------------------------

# Optional. Your Gemini API key. AI drafting stays disabled without it.
# Get one from https://aistudio.google.com/apikey (never commit it).
GEMINI_API_KEY=your-gemini-api-key-here

# Must be exactly "true" (plus GEMINI_API_KEY above) to enable drafting.
# Any other value, or unset, means: deterministic templates only.
AI_DRAFTING_ENABLED=false

# Optional model override. Default (verified): gemini-3.5-flash-lite
# Note: gemini-2.0-flash was shut down on 2026-06-01 - do not use it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local path overrides for the dashboard / seeder.
# Tests set these automatically; you normally do not need them.
# DASHBOARD_STATE_DIR=./state
# DASHBOARD_AUDIT_PATH=./audit/audit_log.jsonl
# DASHBOARD_CSV_DIR=.
